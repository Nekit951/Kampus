package com.example.myapplication.activities

import android.text.Editable
import android.text.TextWatcher
import android.widget.EditText

class CardNumberText(private val editText: EditText): TextWatcher {

    private val space = ' '

    override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}

    override fun onTextChanged(s: CharSequence?, start: Int, count: Int, after: Int){}

    override fun afterTextChanged(s: Editable?) {
        if (s == null) return

        editText.removeTextChangedListener(this)

        // Удаляем все пробелы, оставляем только цифры
        val initialString = s.toString().replace(space.toString(), "")
        val filteredString = if (initialString.length > 16) initialString.substring(0, 16) else initialString

        val sb = StringBuilder()
        for (i in filteredString.indices) {
            sb.append(filteredString[i])
            // Добавляем пробел после каждой 4-й цифры, если это не конец строки
            if ((i + 1) % 4 == 0 && i + 1 < filteredString.length) {
                sb.append(space)
            }
        }

        val result = sb.toString()
        editText.setText(result)
        editText.setSelection(result.length) // Смещение курсора строго в конец строки

        editText.addTextChangedListener(this)
    }
}
